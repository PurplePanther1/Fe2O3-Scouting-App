rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Direct membership check against the real team document. Safe to use anywhere
    // EXCEPT the teams/{teamId} document's own read rule (see that rule for why).
    function isTeamMember(teamId) {
      return isAuth()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([request.auth.uid]);
    }

    function isCaptain(teamData) {
      return teamData != null && teamData.roles != null && teamData.roles[request.auth.uid] == 'captain';
    }

    // Rewritten to guard every get() with exists() first, same style as isTeamMember(),
    // instead of binding a get()/null ternary to a variable — that eager `let` mixed a
    // Resource type with a literal `null` (the source of the "Expected map" compiler
    // warnings), and being a `let` it was evaluated unconditionally on every call, which
    // is what made canEditOrDeleteEntry() throw (and deny) even on the entry.scoutedBy ==
    // request.auth.uid branch that should have short-circuited past it.
    function canEditTemplates(teamId) {
      return isAuth()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && (
          isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data) ||
          (
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid] != null &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canEditTemplates == true
          )
        );
    }

    function canEditOrDeleteEntry(teamId, entry) {
      return isAuth() && (
        (
          teamId != null
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data)
        )
        ||
        entry.scoutedBy == request.auth.uid
        ||
        (
          teamId != null
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid] != null
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canEditOtherEntries == true
        )
      );
    }

    match /teams/{teamId} {
      // Only real members can read the full document. resource.data is already the
      // document being evaluated, so no get()/isTeamMember() (and no dependency on
      // userTeams) is needed here at all.
      allow read: if isAuth() && resource.data.members.hasAny([request.auth.uid]);

      allow create: if isAuth()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[request.auth.uid] == 'captain';

      allow update: if isAuth() && (
        // An existing member updating the team (captain required to touch
        // roles/permissions/name/joinCode; pinnedEvents may also be touched by a
        // member with permissions[uid].canPinEvents == true)
        (
          resource.data.members.hasAny([request.auth.uid])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'permissions', 'name', 'joinCode'])
              || resource.data.roles[request.auth.uid] == 'captain')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinnedEvents'])
              || resource.data.roles[request.auth.uid] == 'captain'
              || (resource.data.permissions != null
                  && resource.data.permissions[request.auth.uid] != null
                  && resource.data.permissions[request.auth.uid].canPinEvents == true))
        )
        ||
        // A brand-new user joining: the ONLY change allowed is appending their own
        // uid to `members` — this is what lets someone join without needing read
        // access to the team doc first (they resolve the join code via the
        // joinCodes lookup below, then blind-update by ID).
        (
          !resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        )
      );

      allow delete: if false;

      match /formConfig/{configDoc} {
        allow read: if isTeamMember(teamId);
        allow create, update: if isAuth()
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && canEditTemplates(teamId);
        allow delete: if false;
      }
    }

    // Denormalized per-user pointer to their current {teamId, role}. Used only so
    // the private/contact rule below can check "is the requester the captain of the
    // SAME team as the profile they're reading" without needing read access to the
    // (member-gated) teams/{teamId} document itself. Self-write only, and the write
    // is cross-validated against the real team doc, so it can't be forged to claim
    // a membership/captaincy that isn't real.
    match /userTeams/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create, update: if isAuth() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.members.hasAny([uid])
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.roles[uid] == request.resource.data.role;
      allow delete: if false;
    }

    // Public lookup so a join code can be resolved to a team ID without needing
    // read access to the (member-gated) team document itself. Exposing "this code
    // maps to this team" isn't a new leak — that's exactly what a join code is for.
    match /joinCodes/{code} {
      allow read: if isAuth();
      allow create: if isAuth()
        && !exists(/databases/$(database)/documents/joinCodes/$(code))
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == code
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.roles[request.auth.uid] == 'captain';
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId} {
      // Public profile: display name + avatar only — not sensitive.
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;

      // Private contact info (email): visible only to the user themself, or the
      // captain of the same team (via the userTeams pointers above).
      match /private/contact {
        allow read: if isAuth() && (
          request.auth.uid == userId
          || (
            exists(/databases/$(database)/documents/userTeams/$(request.auth.uid))
            && exists(/databases/$(database)/documents/userTeams/$(userId))
            && get(/databases/$(database)/documents/userTeams/$(request.auth.uid)).data.teamId
               == get(/databases/$(database)/documents/userTeams/$(userId)).data.teamId
            && get(/databases/$(database)/documents/userTeams/$(request.auth.uid)).data.role == 'captain'
          )
        );
        allow write: if isAuth() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /events/{eventCode} {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && request.resource.data.name is string
        && request.resource.data.ftcTeams is list;
      allow delete: if false;
    }

    match /eventCache/{documentId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.events is list;
    }

    match /teamDetails/{documentId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.name is string;
    }

    match /pitScouting/{documentId} {
      // resource is null for a brand-new (not-yet-created) document. Letting a
      // null-resource read through is safe — there's no data to leak from a
      // document that doesn't exist — and it's what allows the client's
      // existence-check .get() (used to decide create vs. update) to succeed
      // instead of being denied outright.
      allow read: if resource == null || isTeamMember(resource.data.teamId);
      allow create: if isAuth() && isTeamMember(request.resource.data.teamId);
      allow update: if isAuth()
        && canEditOrDeleteEntry(resource.data.teamId, resource.data)
        && request.resource.data.scoutedBy == resource.data.scoutedBy;
      allow delete: if isAuth() && canEditOrDeleteEntry(resource.data.teamId, resource.data);
    }

    match /matchScouting/{documentId} {
      allow read: if resource == null || isTeamMember(resource.data.teamId);
      allow create: if isAuth() && isTeamMember(request.resource.data.teamId);
      allow update: if isAuth()
        && canEditOrDeleteEntry(resource.data.teamId, resource.data)
        && request.resource.data.scoutedBy == resource.data.scoutedBy;
      allow delete: if isAuth() && canEditOrDeleteEntry(resource.data.teamId, resource.data);
    }
  }
}
