rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Direct membership check against the real team document. Safe to use anywhere
    // EXCEPT the teams/{teamId} document's own read rule (see that rule for why).
    function isTeamMember(teamId) {
      return isAuth()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([request.auth.uid]);
    }

    // .get(request.auth.uid, null) rather than roles[request.auth.uid] — a
    // plain member (never captain, never explicitly demoted — only the
    // captain ever gets a roles{} entry at all, see teams/{teamId}'s own
    // create rule below) has NO key for themselves in roles at all, not
    // just a falsy one. Direct bracket access throws in that case — found
    // via CATEGORY 3's emulator testing this round, in a scenario nothing
    // before this had ever actually exercised: a plain member with no
    // roles/permissions entries of their own attempting a write that should
    // be grantable via some OTHER, non-captain path (the live-collaboration
    // co-editing gate) while THIS function is ALSO evaluated as a sibling
    // OR-clause and throws — an error anywhere in the expression denied the
    // whole write even though the other clause alone should have allowed
    // it. This is the single most-called permission primitive in the whole
    // file (isCaptain is used directly or via canEditOrDeleteEntry/
    // canEditTemplates almost everywhere), so this one fix likely closes
    // several more latent instances of the same risk beyond the one this
    // round's testing happened to surface.
    function isCaptain(teamData) {
      return teamData != null && teamData.roles != null && teamData.roles.get(request.auth.uid, null) == 'captain';
    }

    // Rewritten to guard every get() with exists() first, same style as isTeamMember(),
    // instead of binding a get()/null ternary to a variable — that eager `let` mixed a
    // Resource type with a literal `null` (the source of the "Expected map" compiler
    // warnings), and being a `let` it was evaluated unconditionally on every call, which
    // is what made canEditOrDeleteEntry() throw (and deny) even on the entry.scoutedBy ==
    // request.auth.uid branch that should have short-circuited past it.
    function canEditTemplates(teamId) {
      return isAuth()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && (
          isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data) ||
          (
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid] != null &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canEditTemplates == true
          )
        );
    }

    function canEditOrDeleteEntry(teamId, entry) {
      return isAuth() && (
        (
          teamId != null
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data)
        )
        ||
        // .get('scoutedBy', null) rather than entry.scoutedBy — under the
        // checkpoint ownership model (js/live-entry-sync.js), scoutedBy is
        // legitimately absent on a real, valid entry until its first commit
        // (see isValidScoutedByWrite below), and dot/bracket access on a
        // genuinely-missing map key THROWS in Firestore rules rather than
        // evaluating to null — which silently denied every single write
        // (including the plain "join" heartbeat/field-value writes that
        // never even touch scoutedBy) on any not-yet-committed entry until
        // this was caught in testing.
        entry.get('scoutedBy', null) == request.auth.uid
        ||
        (
          teamId != null
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
          // .get(request.auth.uid, null) rather than permissions[request.auth.uid]
          // — same throws-on-missing-key hazard as entry.scoutedBy above,
          // just triggered by a team member who has no permissions map entry
          // of their own at all yet (found while testing this round's fix,
          // not something this feature's redesign newly introduced, but a
          // real latent crash risk in the same code path all the same).
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions.get(request.auth.uid, null) != null
          && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions.get(request.auth.uid, null).canEditOtherEntries == true
        )
      );
    }

    // ====== Live-collaboration ownership model (pit/match scouting entries,
    // wishlist item 10) ======
    // activeEditors (a map field on the entry doc itself — see
    // js/live-entry-sync.js for why it has to live there rather than a
    // subcollection: rules can get()/exists() a specific document path but
    // cannot query or enumerate a collection, so "is anyone else currently
    // present" is only enforceable server-side if it's a field on the very
    // document being written) tracks who currently has this entry open for
    // editing. hasActiveEditors() is a coarse, non-authoritative signal —
    // whether any individual entry is "stale" is a CLIENT-SIDE display
    // concern only (see LIVE_PRESENCE_STALE_MS in live-entry-sync.js); an
    // unpruned crashed-tab entry just leaves the document in the MORE
    // permissive state below forever, which can never lock anyone out, only
    // stay collaborative longer than strictly necessary.
    // .get('activeEditors', null) rather than entry.activeEditors — a LEGACY
    // entry (scoutedBy set, but predating this feature entirely — see
    // isCommittedEntry() below) never had activeEditors written to it at
    // all, so it's genuinely, permanently absent, not just empty. Direct dot
    // access throws in that case (same throws-on-missing-key hazard fixed
    // elsewhere in this file — found here via emulator testing while
    // verifying CATEGORY 3 against real legacy-shaped data, not by
    // inspection: it had gone unnoticed until now because every entry this
    // function was ever actually called against during earlier testing
    // already had activeEditors written, or the error happened to be masked
    // by this file's own OR-branches evaluating true anyway).
    function hasActiveEditors(entry) {
      return entry != null && entry.get('activeEditors', null) != null && entry.get('activeEditors', {}).size() > 0;
    }

    // Has this entry ever actually been committed? checkpoint is the
    // primary signal (js/live-entry-sync.js's commit()); scoutedBy is a
    // fallback for entries scouted before the checkpoint field existed at
    // all — the old model wrote scoutedBy at first save with no checkpoint
    // concept, so those are real, already-saved entries and must be treated
    // as committed here too, not as an open draft (mirrors the client-side
    // isEntryCommitted() in js/live-entry-sync.js — see that function's own
    // comment; CATEGORY 1 of this round). .get(key, null) throughout for the
    // same throws-on-missing-key reason as isValidScoutedByWrite() below —
    // both fields are legitimately absent on a genuine draft.
    function isCommittedEntry(entry) {
      return entry != null
        && (entry.get('checkpoint', null) != null || entry.get('scoutedBy', null) != null);
    }

    // Someone's already actively editing an UNCOMMITTED draft -> any team
    // member may join or edit a field alongside them (including writing a
    // commit's checkpoint/scoutedBy/lastEditedBy, or a cancel's entry-wide
    // revert — see js/live-entry-sync.js's commit()/cancelUndo(), neither of
    // which needs any gate beyond this one: both are always issued by a uid
    // already present in activeEditors at the time, same as an ordinary
    // field write). CATEGORY 3: that door closes permanently once the entry
    // has been committed at least once — isCommittedEntry() — regardless of
    // who else is currently active in it; from that point on only the usual
    // owner/captain/canEditOtherEntries gate applies, same as an entry with
    // no live session ever attached to it at all (a batch-mode match entry,
    // or any entry from before this feature existed). A co-editor who loses
    // access THIS way, mid-session (the entry got committed by someone else
    // while they were still active), is detected and gracefully disconnected
    // client-side — see createLiveEntrySession() in js/live-entry-sync.js —
    // and can still always remove just themselves from activeEditors via
    // isValidSelfLeaveOnly() below, even though this gate now denies
    // everything else they might try.
    function canJoinOrEditEntry(teamId, entry) {
      return isTeamMember(teamId) && (
        (hasActiveEditors(entry) && !isCommittedEntry(entry))
        || canEditOrDeleteEntry(teamId, entry)
      );
    }

    // A uid may ALWAYS remove ONLY ITSELF from activeEditors, regardless of
    // whether canJoinOrEditEntry() above still permits them to edit this
    // entry at all. Without this, a co-editor who loses edit rights
    // mid-session (CATEGORY 3 — the entry got committed by someone else
    // while they were still active, closing the "someone's already active"
    // door behind them) could never even cleanly remove their own now-stale
    // activeEditors entry, leaving it stuck in the document until some
    // unrelated write happens to touch it. Mirrors teams/{teamId}'s own
    // member self-leave branch. The diff must touch ONLY activeEditors, and
    // within that map ONLY the caller's own key — nobody else's entry, and
    // no other field on the document, can be smuggled through under cover
    // of a self-leave.
    function isValidSelfLeaveOnly(before, after) {
      return before.get('activeEditors', null) != null
        && request.auth.uid in before.activeEditors
        && after.diff(before).affectedKeys().hasOnly(['activeEditors'])
        && !(request.auth.uid in after.get('activeEditors', {}))
        && before.activeEditors.diff(after.get('activeEditors', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // scoutedBy ("created by") is create-once, then permanent: it may be SET
    // only when it doesn't already exist (js/live-entry-sync.js's commit()
    // sets it on an entry's first successful Done, never before and never
    // again after), and the value must be the caller's own uid — nobody can
    // assign someone else as creator. There is no more transfer-on-leave:
    // once set, scoutedBy is immutable for the life of the document; the
    // only way it ever changes is the document being deleted and a new one
    // created from scratch, which naturally starts unset again.
    function isValidScoutedByWrite(before, after) {
      return before.get('scoutedBy', null) == after.get('scoutedBy', null)
        || (before.get('scoutedBy', null) == null && after.get('scoutedBy', null) == request.auth.uid);
    }

    // Narrow carve-out for a member with ONLY canKickMembers (no captain, no
    // canEditOtherEntries — those two already pass canEditOrDeleteEntry()
    // above regardless of the target's current membership, so this only ever
    // matters for the canKickMembers-only case): may still anonymize a
    // single field — scoutedByName or lastEditedByName — on an entry whose
    // relevant uid (scoutedBy or lastEditedBy, matching whichever field is
    // being touched, passed in as uidField/nameField) is no longer a member
    // of this team. Checked as two independent calls (one per field) rather
    // than one combined branch, since an entry's departed scouter and its
    // still-present last-editor can be different people. hasOnly([nameField])
    // guarantees nothing else — including scoutedBy/lastEditedBy themselves —
    // changes, and the new value must be the literal 'Deleted User' string
    // already used everywhere else this happens, never arbitrary text.
    function canAnonymizeDepartedField(teamId, before, after, uidField, nameField) {
      return isAuth()
        && teamId != null
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
        // .get(request.auth.uid, null) rather than the old in-guarded
        // permissions[request.auth.uid] — same throws-on-missing-key hazard
        // fixed elsewhere in this file (canEditOrDeleteEntry, above), just
        // never actually exercised here until CATEGORY 3's testing this
        // round used a team where a member has a genuinely EMPTY
        // permissions map (no entry at all, not even an empty one) — the
        // preceding `in` check alone wasn't a reliable enough guard against
        // the bracket access on the line right after it.
        && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions.get(request.auth.uid, null) != null
        && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions.get(request.auth.uid, null).canKickMembers == true
        // before.get(uidField, null) rather than before[uidField] — uidField
        // is 'scoutedBy' or 'lastEditedBy', either of which can now be
        // legitimately absent on a real entry (see isValidScoutedByWrite's
        // comment above) — direct bracket access throws in that case.
        // before.get(uidField, null) != null guards the case where it's
        // genuinely unset: there's no departed uid to anonymize for, so this
        // is correctly not a match rather than a (meaningless) vacuous one.
        && before.get(uidField, null) != null
        && !get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([before.get(uidField, null)])
        && after.diff(before).affectedKeys().hasOnly([nameField])
        && after[nameField] == 'Deleted User';
    }

    // Narrow carve-out for a still-current member anonymizing their OWN
    // lastEditedByName — entry.lastEditedBy == request.auth.uid — even on
    // an entry they didn't originally scout (entry.scoutedBy belongs to
    // someone else). canEditOrDeleteEntry()'s self-branch only covers
    // entry.scoutedBy == request.auth.uid, which doesn't help here: a
    // member can be the most recent editor of a teammate's entry without
    // being its original scouter, and without holding canEditOtherEntries.
    // This is what lets anonymizeOwnScoutingEntries() (used by both Leave
    // Team and Delete Account) fully anonymize every entry this uid
    // touched, not just the ones they originally scouted. No team-doc
    // lookup needed — unlike canAnonymizeDepartedField(), this is a
    // currently-active member writing their own attribution, not a kicker
    // cleaning up someone else's, so there's no membership/permission
    // condition to check, only the diff shape.
    function canAnonymizeOwnLastEdit(before, after) {
      return isAuth()
        // before.get('lastEditedBy', null) rather than before.lastEditedBy —
        // under the checkpoint model (js/live-entry-sync.js's commit()),
        // lastEditedBy can now be legitimately, permanently absent (it's only
        // ever set on a commit whose checkpoint differs from the prior one),
        // and direct dot access throws on a genuinely-missing key.
        && before.get('lastEditedBy', null) == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['lastEditedByName'])
        && after.lastEditedByName == 'Deleted User';
    }

    // A valid "kick" diff shape: exactly one member (never the caller — that's
    // self-leave's job — and never the captain, who can't be kicked) is removed
    // from members, and — if present — only that removed member's own entries
    // from roles/permissions. The target uid isn't a rule parameter, so it's
    // derived from the diff itself via removeAll(), then re-verified against
    // every other field so a kick can't be smuggled alongside an unrelated
    // members change (e.g. adding someone else in the same write). Caller's
    // permission to kick AT ALL (captain or canKickMembers) is checked
    // separately at each call site, same layering as canEditOrDeleteEntry()
    // being combined with other conditions where it's used.
    function isValidKickDiff(before, after) {
      let removed = before.members.removeAll(after.members);
      return removed.size() == 1
        && removed[0] != request.auth.uid
        && !(removed[0] in before.roles && before.roles[removed[0]] == 'captain')
        && after.members == before.members.removeAll(removed)
        && after.diff(before).affectedKeys().hasOnly(['members', 'roles', 'permissions'])
        && (!after.diff(before).affectedKeys().hasAny(['roles'])
            || (!(removed[0] in after.roles)
                && before.roles.diff(after.roles).affectedKeys().hasOnly([removed[0]])))
        && (!after.diff(before).affectedKeys().hasAny(['permissions'])
            || (!(removed[0] in after.permissions)
                && before.permissions.diff(after.permissions).affectedKeys().hasOnly([removed[0]])));
    }

    match /teams/{teamId} {
      // Only real members can read the full document. resource.data is already the
      // document being evaluated, so no get()/isTeamMember() (and no dependency on
      // userTeams) is needed here at all.
      allow read: if isAuth() && resource.data.members.hasAny([request.auth.uid]);

      allow create: if isAuth()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[request.auth.uid] == 'captain';

      allow update: if isAuth() && (
        // An existing member updating the team (captain required to touch
        // roles/permissions/name/joinCode/members; pinnedEvents may also be
        // touched by a member with permissions[uid].canPinEvents == true).
        // `members` is included here as defense in depth even though captain
        // has no *current* legitimate reason to touch it via this branch —
        // join/self-leave/kick each have their own dedicated branch below —
        // without this it was unguarded here entirely: any member could
        // rewrite `members` to anything, as long as the same write didn't
        // also touch roles/permissions/name/joinCode.
        (
          resource.data.members.hasAny([request.auth.uid])
          // Guarded with an `in` presence check before indexing into roles —
          // bracket access on a map key that doesn't exist throws in Firestore
          // rules (unlike plain dot-field access, which returns null), and a
          // plain member who never had roles.{uid} written would otherwise
          // throw here instead of cleanly failing the captain check.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'permissions', 'name', 'joinCode', 'members'])
              || (request.auth.uid in resource.data.roles && resource.data.roles[request.auth.uid] == 'captain'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinnedEvents'])
              || resource.data.roles[request.auth.uid] == 'captain'
              || (resource.data.permissions != null
                  && resource.data.permissions[request.auth.uid] != null
                  && resource.data.permissions[request.auth.uid].canPinEvents == true))
        )
        ||
        // A brand-new user joining: the ONLY change allowed is appending their own
        // uid to `members` — this is what lets someone join without needing read
        // access to the team doc first (they resolve the join code via the
        // joinCodes lookup below, then blind-update by ID).
        (
          !resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        )
        ||
        // Self-leave (used by account deletion): a member removes only their own
        // uid from members, and — if present — only their own entries from
        // roles/permissions. A captain may only do this if they're the last
        // remaining member; otherwise they must transfer captaincy first.
        // Enforced here too, not just in the client UI, since this is a
        // destructive, security-relevant operation.
        (
          resource.data.members.hasAny([request.auth.uid])
          // Same `in`-guard reasoning as branch 1 above — a plain member with
          // no roles.{uid} entry must resolve to "not captain" without ever
          // indexing the missing key.
          && (!(request.auth.uid in resource.data.roles) || resource.data.roles[request.auth.uid] != 'captain' || resource.data.members.size() == 1)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'permissions'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
              || (!(request.auth.uid in request.resource.data.roles)
                  && resource.data.roles.diff(request.resource.data.roles).affectedKeys().hasOnly([request.auth.uid])))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
              || (!(request.auth.uid in request.resource.data.permissions)
                  && resource.data.permissions.diff(request.resource.data.permissions).affectedKeys().hasOnly([request.auth.uid])))
        )
        ||
        // Kick: a captain, or a member with permissions[uid].canKickMembers ==
        // true, removes exactly one OTHER current member — never themselves
        // (self-leave's branch above handles that) and never the captain (who
        // can't be kicked). isValidKickDiff() enforces the diff shape; this
        // just gates who's allowed to invoke it at all.
        (
          resource.data.members.hasAny([request.auth.uid])
          && (
            (request.auth.uid in resource.data.roles && resource.data.roles[request.auth.uid] == 'captain')
            || (resource.data.permissions != null
                && request.auth.uid in resource.data.permissions
                && resource.data.permissions[request.auth.uid].canKickMembers == true)
          )
          && isValidKickDiff(resource.data, request.resource.data)
        )
      );

      // Only when you are the literal last member — mirrors the self-leave
      // branch's members.size() == 1 condition above. Whoever is the sole
      // remaining member is always its captain: the self-leave branch blocks
      // a captain from leaving while other members remain, and
      // transferCaptaincy() always writes an explicit roles.{uid} = 'captain'
      // for whoever it hands the role to — so there's no path to a lone
      // non-captain survivor, and no separate role check is needed here.
      allow delete: if isAuth()
        && resource.data.members.size() == 1
        && resource.data.members.hasAny([request.auth.uid]);

      match /formConfig/{configDoc} {
        allow read: if isTeamMember(teamId);
        allow create, update: if isAuth()
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && canEditTemplates(teamId);
        // Same last-member-only condition as the team doc's own delete rule
        // above — this subcollection doc isn't the team doc itself, so it
        // needs its own get() rather than inheriting resource.data directly.
        allow delete: if isAuth()
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.members.size() == 1
          && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([request.auth.uid]);
      }

      // Nested pit-scouting subcollection — lives alongside the flat
      // /pitScouting/{documentId} collection below during the data-reorg
      // migration; both rule sets are active at once so existing flat docs
      // keep working while newly-migrated docs read/write here. teamId comes
      // from the path itself now, not resource.data.teamId, so every
      // permission function below is called with the trusted path segment —
      // no dependency on a client-supplied field, and no null-resource
      // special case is needed for that reason. The resource == null branch
      // on read is kept anyway, purely for parity with the flat collection's
      // rule (a nonexistent doc leaks nothing either way, so this is a no-op
      // change in practice, not a tightening or loosening of access).
      // allow update's first clause accepts EITHER the classic owner/captain/
      // canEditOtherEntries gate OR canJoinOrEditEntry's "someone's already
      // actively editing" case (live-collaboration ownership model, wishlist
      // item 10), and scoutedBy may only be set once (isValidScoutedByWrite,
      // above) — no more transfer-on-leave. An entry that never goes through
      // js/live-entry-sync.js (no activeEditors field ever written) behaves
      // under this rule exactly as it did before this feature existed —
      // hasActiveEditors() is false, canJoinOrEditEntry() reduces to
      // canEditOrDeleteEntry(), and isValidScoutedByWrite() only ever takes
      // its "unchanged" branch (its "newly set" branch already matches what
      // a plain first save always did anyway). The standalone delete rule
      // deliberately stays on canEditOrDeleteEntry (not canJoinOrEditEntry)
      // — an earlier round of this feature widened delete to any active
      // editor so a non-privileged co-editor could delete-on-cancel, but
      // cancel no longer deletes anything under this model (it's a per-field
      // revert — see js/live-entry-sync.js's cancelUndo()), so that widening
      // has no remaining justification and is reverted here.
      match /pitScouting/{documentId} {
        allow read: if resource == null || isTeamMember(teamId);
        allow create: if isAuth() && isTeamMember(teamId);
        allow update: if isAuth() && (
          (canJoinOrEditEntry(teamId, resource.data)
            && isValidScoutedByWrite(resource.data, request.resource.data))
          || isValidSelfLeaveOnly(resource.data, request.resource.data)
          || canAnonymizeDepartedField(teamId, resource.data, request.resource.data, 'scoutedBy', 'scoutedByName')
          || canAnonymizeDepartedField(teamId, resource.data, request.resource.data, 'lastEditedBy', 'lastEditedByName')
          || canAnonymizeOwnLastEdit(resource.data, request.resource.data)
        );
        allow delete: if isAuth() && canEditOrDeleteEntry(teamId, resource.data);
      }

      // Nested match-scouting subcollection — mirrors the pit-scouting block
      // above exactly (same functions, same shape, both active alongside the
      // flat /matchScouting/{documentId} collection below during the data-
      // reorg migration). Match's doc-ID scheme and per-match cardinality
      // differ from pit's at the application layer, but none of that is
      // visible to these rules — teamId, scoutedBy, lastEditedBy, checkpoint,
      // and activeEditors are the only fields any of this depends on, same
      // as pit. Only entries opened from the match-based/schedule view ever
      // get a live session attached (js/match-scout.js keeps the team-based
      // view's manual entry flow on the pre-existing batch-save model) — this
      // rule doesn't need to know or care which entry point created a given
      // doc, since canJoinOrEditEntry()/isValidScoutedByWrite() already
      // degrade to today's exact behavior for any entry with no
      // activeEditors field.
      match /matchScouting/{documentId} {
        allow read: if resource == null || isTeamMember(teamId);
        allow create: if isAuth() && isTeamMember(teamId);
        allow update: if isAuth() && (
          (canJoinOrEditEntry(teamId, resource.data)
            && isValidScoutedByWrite(resource.data, request.resource.data))
          || isValidSelfLeaveOnly(resource.data, request.resource.data)
          || canAnonymizeDepartedField(teamId, resource.data, request.resource.data, 'scoutedBy', 'scoutedByName')
          || canAnonymizeDepartedField(teamId, resource.data, request.resource.data, 'lastEditedBy', 'lastEditedByName')
          || canAnonymizeOwnLastEdit(resource.data, request.resource.data)
        );
        allow delete: if isAuth() && canEditOrDeleteEntry(teamId, resource.data);
      }

      // Per-team copy of a member's email — lets THIS team's captain (or a
      // teammate granted canViewMemberEmails) see it, scoped to this team
      // specifically. Replaces the old userTeams-based cross-user pointer
      // comparison, which could only express "shared team" correctly when
      // every user had exactly one — with multi-team support, "captain of
      // some team we happen to share" is the wrong (leaky) question; the
      // right one is "captain of THIS team," which this rule answers
      // directly without any cross-referencing. Self-write only, cross-
      // validated against real membership on this specific team.
      match /memberContacts/{uid} {
        // Must include self-access: ensureMemberContact() (auth.js) does a
        // read first to check whether a write is even needed, before every
        // member's own doc necessarily exists — without this clause that
        // read is denied for anyone who isn't already captain/permitted,
        // which throws, which skips the write that follows it in the same
        // try block. The result: no plain member's doc ever gets created,
        // so captain/permitted-teammate reads of it later find nothing.
        allow read: if isTeamMember(teamId) && (
          request.auth.uid == uid
          || isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data)
          || (
            get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
            && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid] != null
            && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canViewMemberEmails == true
          )
        );
        allow write: if isAuth() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([uid]);
        // Self-delete (leaving) is unconditional. A captain or canKickMembers-
        // permitted teammate may also delete someone ELSE's contact doc — this
        // is what lets kickMember() clean up the kicked member's copy, which
        // that member's own client isn't around to do (unlike selfLeaveTeam(),
        // which runs on the leaving member's own client and can delete its own
        // doc under the self-delete clause above).
        allow delete: if isAuth() && (
          request.auth.uid == uid
          || (
            exists(/databases/$(database)/documents/teams/$(teamId))
            && (
              isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data)
              || (
                get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
                && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.permissions
                && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canKickMembers == true
              )
            )
          )
        );
      }

      // Per-team override of a member's display name — unlike memberContacts
      // (email), this is NOT sensitive: it exists specifically so teammates see
      // it (member list, scouting entry attribution), same audience as the
      // team-wide member list itself, so read is any team member rather than
      // captain/permission-gated. Write/delete rules otherwise mirror
      // memberContacts exactly (self-write cross-validated against real
      // membership; self-delete or captain/canKickMembers-permitted teammate
      // delete, for kickMember() cleanup).
      match /memberDisplayNames/{uid} {
        allow read: if isTeamMember(teamId);
        allow write: if isAuth() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasAny([uid]);
        allow delete: if isAuth() && (
          request.auth.uid == uid
          || (
            exists(/databases/$(database)/documents/teams/$(teamId))
            && (
              isCaptain(get(/databases/$(database)/documents/teams/$(teamId)).data)
              || (
                get(/databases/$(database)/documents/teams/$(teamId)).data.permissions != null
                && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.permissions
                && get(/databases/$(database)/documents/teams/$(teamId)).data.permissions[request.auth.uid].canKickMembers == true
              )
            )
          )
        );
      }
    }

    // Public lookup so a join code can be resolved to a team ID without needing
    // read access to the (member-gated) team document itself. Exposing "this code
    // maps to this team" isn't a new leak — that's exactly what a join code is for.
    match /joinCodes/{code} {
      allow read: if isAuth();
      allow create: if isAuth()
        && !exists(/databases/$(database)/documents/joinCodes/$(code))
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == code
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.roles[request.auth.uid] == 'captain'
        && request.resource.data.name == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name;
      allow update: if false;
      // Only when the team this code points to is down to its last member —
      // same condition as teams/{teamId}'s own delete rule, checked via the
      // team this specific joinCodes doc's teamId field references.
      allow delete: if isAuth()
        && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.members.size() == 1
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.members.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      // Public profile: display name + avatar only — not sensitive.
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAuth() && request.auth.uid == userId;

      // Private contact info (email): self only. Teammates who can see a
      // member's email read the per-team copy at
      // teams/{teamId}/memberContacts/{uid} instead (see above).
      match /private/contact {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if isAuth() && request.auth.uid == userId;
        allow delete: if isAuth() && request.auth.uid == userId;
      }
    }

    match /events/{eventCode} {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && request.resource.data.name is string
        && request.resource.data.ftcTeams is list;
      allow delete: if false;
    }

    match /eventCache/{documentId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.events is list;
    }

    match /teamDetails/{documentId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.name is string;
    }

    match /pitScouting/{documentId} {
      // resource is null for a brand-new (not-yet-created) document. Letting a
      // null-resource read through is safe — there's no data to leak from a
      // document that doesn't exist — and it's what allows the client's
      // existence-check .get() (used to decide create vs. update) to succeed
      // instead of being denied outright.
      allow read: if resource == null || isTeamMember(resource.data.teamId);
      allow create: if isAuth() && isTeamMember(request.resource.data.teamId);
      allow update: if isAuth() && (
        // .get('scoutedBy', null) rather than plain .scoutedBy on both sides
        // — same throws-on-missing-key hazard fixed elsewhere in this file
        // (see isValidScoutedByWrite() above) applied here preventively.
        // This legacy flat collection is no longer written by any current
        // code path (both entry types now live under
        // teams/{teamId}/pitScouting — see that match block's own header
        // comment), and every pre-migration doc here always had scoutedBy
        // set at creation under the old model, so this was never actually
        // observed to throw — just closing the same class of latent crash
        // risk on the offhand chance an old doc is ever touched again.
        (canEditOrDeleteEntry(resource.data.teamId, resource.data)
          && request.resource.data.get('scoutedBy', null) == resource.data.get('scoutedBy', null))
        || canAnonymizeDepartedField(resource.data.teamId, resource.data, request.resource.data, 'scoutedBy', 'scoutedByName')
        || canAnonymizeDepartedField(resource.data.teamId, resource.data, request.resource.data, 'lastEditedBy', 'lastEditedByName')
        || canAnonymizeOwnLastEdit(resource.data, request.resource.data)
      );
      allow delete: if isAuth() && canEditOrDeleteEntry(resource.data.teamId, resource.data);
    }

    match /matchScouting/{documentId} {
      allow read: if resource == null || isTeamMember(resource.data.teamId);
      allow create: if isAuth() && isTeamMember(request.resource.data.teamId);
      allow update: if isAuth() && (
        // See pitScouting's own copy of this comment, just above.
        (canEditOrDeleteEntry(resource.data.teamId, resource.data)
          && request.resource.data.get('scoutedBy', null) == resource.data.get('scoutedBy', null))
        || canAnonymizeDepartedField(resource.data.teamId, resource.data, request.resource.data, 'scoutedBy', 'scoutedByName')
        || canAnonymizeDepartedField(resource.data.teamId, resource.data, request.resource.data, 'lastEditedBy', 'lastEditedByName')
        || canAnonymizeOwnLastEdit(resource.data, request.resource.data)
      );
      allow delete: if isAuth() && canEditOrDeleteEntry(resource.data.teamId, resource.data);
    }
  }
}
